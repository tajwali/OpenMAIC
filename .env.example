# ============================================
# OpenMAIC 2.0 Configuration
# Copy this file to .env.local and fill in your keys
# cp .env.example .env.local
# ============================================

# ---- LLM Provider (choose one) ----

# Option A: Google Gemini (recommended)
# Get free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-gemini-api-key
DEFAULT_MODEL=google:gemini-2.5-flash

# Option B: OpenRouter (free models available)
# Get key at: https://openrouter.ai/keys
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=openai:nvidia/nemotron-3-super-120b-a12b:free

# ---- Image Generation ----
# Uses same Google API key as LLM above
IMAGE_NANO_BANANA_API_KEY=your-google-gemini-api-key

# ---- Text to Speech ----
# Requires Google Cloud TTS API key
# Enable at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# First 1 million characters/month are FREE
GOOGLE_TTS_API_KEY=your-google-cloud-tts-api-key
TTS_OPENAI_API_KEY=dummy
TTS_OPENAI_BASE_URL=http://localhost:5050

# ---- Supabase Self-Hosted ----
# Follow DEPLOYMENT.md to set up your own Supabase stack
NEXT_PUBLIC_SUPABASE_URL=http://your-supabase-ip:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-token
SUPABASE_SERVICE_KEY=your-service-role-jwt-token
SUPABASE_JWT_SECRET=your-jwt-secret-32-chars-minimum
SUPABASE_AUTH_URL=http://your-supabase-ip:9999
