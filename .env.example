# ============================================
# OpenMAIC 2.0 Configuration
# Copy this file to .env.local and fill in your keys
# cp .env.example .env.local
# ============================================

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Set your preferred AI model. Format: provider:model-name
# The app automatically falls back to gemini-2.0-flash → gemini-1.5-flash
# if your chosen model is overloaded or unavailable.
#
# Option A: Google Gemini (recommended — free tier available)
# Get key at: https://aistudio.google.com/apikey
#
#   DEFAULT_MODEL=google:gemini-2.0-flash     (fast and reliable — recommended)
#   DEFAULT_MODEL=google:gemini-2.5-flash     (higher quality, may be busy)
#   DEFAULT_MODEL=google:gemini-1.5-flash     (most stable free tier)
#
# Option B: OpenRouter (many free models available)
# Get key at: https://openrouter.ai/keys
#
#   DEFAULT_MODEL=openai:nvidia/nemotron-3-super-120b-a12b:free
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=your-openrouter-key
# =============================================================================
GOOGLE_API_KEY=your-google-gemini-api-key
DEFAULT_MODEL=google:gemini-2.0-flash

# OpenRouter alternative (uncomment to use)
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL=openai:nvidia/nemotron-3-super-120b-a12b:free

# ---- Image Generation ----
# Uses same Google API key as LLM above
IMAGE_NANO_BANANA_API_KEY=your-google-gemini-api-key

# ---- Text to Speech ----
# Requires Google Cloud TTS API key
# Enable at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# First 1 million characters/month are FREE
GOOGLE_TTS_API_KEY=your-google-cloud-tts-api-key
TTS_OPENAI_API_KEY=dummy
TTS_OPENAI_BASE_URL=http://localhost:5050

# ---- Supabase Self-Hosted (Protected) ----
# Follow DEPLOYMENT.md to set up your own Supabase stack
NEXT_PUBLIC_SUPABASE_URL=http://your-supabase-ip:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-token
SUPABASE_SERVICE_KEY=your-service-role-jwt-token
SUPABASE_JWT_SECRET=your-jwt-secret-32-chars-minimum
SUPABASE_AUTH_URL=http://your-supabase-ip:9999

# --- Additional Model Providers ----------------------------------------------
GOOGLE_BASE_URL=
GOOGLE_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODELS=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODELS=

KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODELS=

MINIMAX_API_KEY=
# MiniMax Anthropic-compatible endpoint for the built-in Anthropic SDK integration
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
# Example: MiniMax-M2.7,MiniMax-M2.7-highspeed,MiniMax-M2.5,MiniMax-M2.1
MINIMAX_MODELS=

GLM_API_KEY=
GLM_BASE_URL=
GLM_MODELS=

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODELS=

DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODELS=

GROK_API_KEY=
GROK_BASE_URL=
GROK_MODELS=

# --- TTS (Text-to-Speech) ----------------------------------------------------

TTS_AZURE_API_KEY=
TTS_AZURE_BASE_URL=

TTS_GLM_API_KEY=
TTS_GLM_BASE_URL=

TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=

TTS_MINIMAX_API_KEY=
# MiniMax TTS endpoint (speech-2.8 / 2.6 / 02 / 01 series)
TTS_MINIMAX_BASE_URL=https://api.minimaxi.com
TTS_ELEVENLABS_API_KEY=
TTS_ELEVENLABS_BASE_URL=

